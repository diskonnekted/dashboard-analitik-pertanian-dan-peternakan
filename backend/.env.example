# Backend SISPERTANI — salin ke .env
PORT=4100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=sispertani
# Origin yang boleh mengakses (CORS). Pisahkan koma untuk banyak origin.
CORS_ORIGIN=http://localhost:5173,https://pertanian.sistemdata.id
# Direktori public frontend — dipakai untuk membaca snapshot CKAN yang sengaja
# tidak diimpor ke DB (mis. padi-2025.csv untuk titik data 2025 di riwayat padi).
PUBLIC_DIR=../public
