# Backend SISPERTANI — salin ke .env
PORT=4100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=sispertani
# Origin yang boleh mengakses (CORS). Pisahkan koma untuk banyak origin.
CORS_ORIGIN=http://localhost:5173,https://pertanian.sistemdata.id
# Direktori public frontend — dipakai untuk membaca snapshot CKAN yang sengaja
# tidak diimpor ke DB (mis. padi-2025.csv untuk titik data 2025 di riwayat padi).
PUBLIC_DIR=../public

# === Akun & Peran (RBAC) ====================================================
# admin: melihat SEMUA domain + sinkronisasi (sync-log & paket).
# Empat akun bidang berikut hanya berhak atas domain bidangnya masing-masing
# (daftar domain & pemetaannya ada di backend/src/lib/users.js).
ADMIN_USER=admin
ADMIN_PASS=ganti-ini
PASS_TANAMAN_PANGAN=ganti-ini
PASS_HORTI_PERKEBUNAN=ganti-ini
PASS_PETERNAKAN=ganti-ini
PASS_PERIKANAN=ganti-ini

# === Produksi (1 × Node.js Site CloudPanel) ================================
# dist/ hasil build Vite dilayani Express dari Application Root; Vite menyalin
# seluruh public/ ke dist/, jadi di produksi snapshot ikut terbaca dari situ.
#DIST_DIR=./dist
#PUBLIC_DIR=./dist
# Proxy CKAN dari origin sendiri (GET /api/3/* → opendata.banjarnegarakab.go.id).
# Default aktif; matikan dengan CKAN_PROXY=0.
#CKAN_PROXY=1
# Bind address produksi: 127.0.0.1 = hanya nginx lokal yang bisa mengakses port
# (server CloudPanel multi-user); 0.0.0.0 (default) = semua interface.
#BIND_HOST=127.0.0.1
