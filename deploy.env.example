# deploy.env.example - salin menjadi deploy.env lalu isi (deploy.env UNTRACKED).
# Target deploy: CloudPanel, site tipe "Node.js" (pola 1 x Node.js Site).

# --- SSH/SFTP: site user CloudPanel (bukan root) ---------------------------
DEPLOY_SSH_HOST=203.0.113.10
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=siteuser
DEPLOY_SSH_PASSWORD=
DEPLOY_DOMAIN=contoh.sistemdata.id

# --- Application Root site Node.js -----------------------------------------
# Lihat di CloudPanel: Sites -> <site> -> Node.js -> Application Root
# (default CloudPanel: /home/<site-user>/htdocs/<domain>)
DEPLOY_APP_ROOT=/home/siteuser/htdocs/contoh.sistemdata.id

# --- Database CloudPanel (menu Databases) - dipakai opsi -ImportDb ---------
DEPLOY_DB_NAME=namadb
DEPLOY_DB_USER=userdb
DEPLOY_DB_PASSWORD=

# --- Sumber dump lokal (XAMPP/MariaDB dev) - dipakai opsi -ImportDb --------
LOCAL_DB_NAME=sispertani
LOCAL_DB_USER=root
LOCAL_DB_PASS=
LOCAL_MYSQLDUMP=D:\xampp\mysql\bin\mysqldump.exe
