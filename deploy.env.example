# Template kredensial deploy produksi (TIDAK berisi nilai rahasia).
# Cara pakai: salin file ini menjadi deploy.env lalu isi nilai produksi:
#   Copy-Item deploy.env.example deploy.env
# deploy.env di-ignore oleh .gitignore dan TIDAK boleh di-commit.
# Jika password SSH diganti di panel hosting, perbarui juga deploy.env.
DEPLOY_SSH_HOST=host-produksi-anda
DEPLOY_SSH_PORT=64001
DEPLOY_SSH_USER=user-ssh-anda
DEPLOY_SSH_PASSWORD=password-ssh-anda
DEPLOY_REMOTE_PATH=/path/htdocs/domain-anda/
